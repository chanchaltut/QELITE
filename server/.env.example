# Copy to server/.env for local development (never commit .env).
MONGODB_URI=mongodb://127.0.0.1:27017/qelite
# 32+ random characters
JWT_SECRET=change-me-to-a-long-random-string-of-40-characters
SITE_URL=http://localhost:5173
ADMIN_EMAIL=admin@qelite.in
ADMIN_PASSWORD=choose-a-strong-password
